# 개발할 때는 스프링부트(localhost:8080)를 먼저 켜고 npm run dev 를 실행하세요.
# /api 요청은 vite.config.js 의 proxy 가 8080 으로 전달해 줘요.

# 소셜 로그인 버튼이 이동할 백엔드 주소 (Vite 프록시를 안 타서 8080 을 직접 적어요)
VITE_OAUTH_BASE_URL=http://localhost:8080

# 카카오맵 JavaScript 키 (루트 추천 화면의 지도). 콘솔 [플랫폼 → Web]에 http://localhost:5173 을 등록해야 지도가 열려요.
# 비워 두면 지도 대신 "목록으로 고르기" 안내가 나와요.
VITE_KAKAO_MAP_APP_KEY=